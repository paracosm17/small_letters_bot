# Production bootstrap: keep smoke mode enabled until DB restore/verification is complete.
APP_ENV=production
LOG_LEVEL=INFO
APP_SMOKE_MODE=true
NOTIFY_ADMINS_ON_STARTUP=false
RELEASE_REVISION=local

# HTTP / Telegram webhook
WEB_SERVER_HOST=0.0.0.0
PORT=8080
WEBHOOK_BASE_URL=https://small-letters.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=

# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789

# PostgreSQL. Prefer DATABASE_URL in Coolify.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Redis FSM storage. Prefer REDIS_URL in Coolify.
# Format: redis://[:PASSWORD@]HOST:6379/0
USE_REDIS=true
REDIS_URL=

# Legacy migration fallbacks remain accepted temporarily:
# DB_HOST=postgres
# DB_PORT=5432
# POSTGRES_DB=small_letters_bot_db
# POSTGRES_USER=small_letters_bot
# POSTGRES_PASSWORD=
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# ADMINS=123456789
